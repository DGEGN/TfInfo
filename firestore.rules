rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function istEingeloggt() {
      return request.auth != null;
    }

    function istBearbeiter() {
      return istEingeloggt() &&
        exists(/databases/$(database)/documents/benutzer/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/benutzer/$(request.auth.uid)).data.freigegeben == true;
    }

    function istAdmin() {
      return istEingeloggt() &&
        exists(/databases/$(database)/documents/benutzer/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/benutzer/$(request.auth.uid)).data.admin == true;
    }

    // Nutzerverwaltung: jeder sieht seinen eigenen Eintrag, nur Admins verwalten Freigaben
    match /benutzer/{uid} {
      allow read: if istEingeloggt() && (request.auth.uid == uid || istAdmin());
      allow create: if istAdmin();
      allow update, delete: if istAdmin();
    }

    // Kontakte, Strecken, Baureihen: Lesen für alle freigegebenen Nutzer,
    // Schreiben/Ändern/Löschen nur für freigegebene Bearbeiter
    match /kontakte/{id} {
      allow read: if istBearbeiter();
      allow write: if istBearbeiter();
    }

    match /strecken/{id} {
      allow read: if istBearbeiter();
      allow write: if istBearbeiter();
    }

    match /baureihen/{id} {
      allow read: if istBearbeiter();
      allow write: if istBearbeiter();
    }

    // Persönliche Notruf-Zielnummer je Nutzer
    match /einstellungen/{uid} {
      allow read, write: if istEingeloggt() && request.auth.uid == uid;
    }
  }
}
